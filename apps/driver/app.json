{
  "expo": {
    "name": "მტრედები - მძღოლი",
    "slug": "mtredebi-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mtredebi-driver",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0EA5E9"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mtredebi.driver",
      "infoPlist": {
        "UIBackgroundModes": ["location", "remote-notification"],
        "NSLocationWhenInUseUsageDescription": "მძღოლის ლოკაციის ჩვენება კლიენტებისთვის",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "მძღოლის ლოკაციის რეალურ დროში განახლება მიწოდების დროს",
        "NSLocationAlwaysUsageDescription": "მძღოლის ლოკაციის რეალურ დროში განახლება მიწოდების დროს"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0EA5E9"
      },
      "package": "com.mtredebi.driver",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "მძღოლის ლოკაციის რეალურ დროში განახლება მიწოდების დროს",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0EA5E9",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
